{
    "name": "blackwall/oauth-server",
    "description": "BlackWall - OAuth 2.1 + OpenID Connect Authorization Server with WebAuthn",
    "type": "project",
    "require": {
        "php": "^8.2",
        "lcobucci/jwt": "^5.2",
        "monolog/monolog": "^3.5",
        "paragonie/constant_time_encoding": "^2.6",
        "psr/log": "^3.0",
        "ramsey/uuid": "^4.7",
        "slim/php-view": "^3.4",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.13",
        "vlucas/phpdotenv": "^5.6",
        "web-auth/cose-lib": "^4.2",
        "web-auth/webauthn-lib": "^4.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "BlackWall\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=PSR12 src/",
        "cbf": "phpcbf --standard=PSR12 src/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
