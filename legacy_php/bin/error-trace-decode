#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = __DIR__ . '/../vendor/autoload.php';
if (is_file($autoload)) {
    require $autoload;
} else {
    require __DIR__ . '/../src/Config.php';
    require __DIR__ . '/../src/Security/ErrorTraceCodec.php';
}

use BlackWall\Config;
use BlackWall\Security\ErrorTraceCodec;

if (is_file($autoload)) {
    Config::load(__DIR__ . '/..');
}

$payload = stream_get_contents(STDIN);
if ($payload === false) {
    fwrite(STDERR, "Failed to read payload from stdin.\n");
    exit(1);
}

if (trim($payload) === '') {
    fwrite(STDERR, "Usage: cat payload.txt | php bin/error-trace-decode\n");
    exit(1);
}

if (!is_file($autoload) && getenv('ERROR_TRACE_KEY') === false && getenv('CSRF_SECRET') === false) {
    fwrite(STDERR, "vendor/autoload.php is missing; export ERROR_TRACE_KEY or CSRF_SECRET before running this script.\n");
    exit(1);
}

try {
    $decoded = ErrorTraceCodec::decode($payload);
} catch (\Throwable $e) {
    fwrite(STDERR, "Decode failed: {$e->getMessage()}\n");
    exit(1);
}

fwrite(STDOUT, $decoded);
if (!str_ends_with($decoded, "\n")) {
    fwrite(STDOUT, PHP_EOL);
}
