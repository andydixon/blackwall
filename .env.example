# BlackWall environment configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://blackwall.cx

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blackwall
DB_USER=blackwall
DB_PASS=CHANGE_ME_***REMOVED***
# disable, require, verify-ca or verify-full. Use require or stricter when the
# database is not reached over a trusted local network.
DB_SSLMODE=disable

# Session
SESSION_NAME=blackwall_session
SESSION_LIFETIME=7200
SESSION_IDLE_TIMEOUT=1800
SESSION_BIND_USER_AGENT=true

# Security
# Generate: openssl rand -base64 32
JWT_SIGNING_KEY=GENERATE_ME_BASE64_32_BYTES
CSRF_SECRET=GENERATE_ME_BASE64_32_BYTES
CRYPTBIN_KEK_BASE64=GENERATE_ME_BASE64_32_BYTES
CRYPTBIN_KEK_VERSION=v1

# WebAuthn
WEBAUTHN_RP_NAME="BlackWall OAuth"
WEBAUTHN_RP_ID=blackwall.cx
# Minimum number of WebAuthn credentials a user must retain.
MIN_WEBAUTHN_KEYS=1

# Admin scope model:
# Users can access /admin if they hold privilege level 1 on at least one project.
# Global super-admin is inferred from level 1 membership on this project.
ADMIN_SUPER_PROJECT_NAME="BlackWall Admin"
# Optional exact UUID override for super-admin project detection.
ADMIN_SUPER_PROJECT_UUID=

# Reverse proxy (set to true if behind nginx/apache proxy)
TRUST_PROXY=false
# Comma-separated list of trusted proxy IPs
TRUSTED_PROXIES=127.0.0.1

# Rate limiting
RATE_LIMIT_ENABLED=true

# Maintenance
# Audit log retention window used by cleanup job.
AUDIT_RETENTION_DAYS=180
# Auto-reject pending approval requests older than this many days.
APPROVAL_PENDING_MAX_AGE_DAYS=14

# Admin mutation endpoint rate limiting.
ADMIN_MUTATION_RATE_LIMIT_ATTEMPTS=60
ADMIN_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
# Dashboard warning threshold for aged pending approvals.
ADMIN_APPROVAL_PENDING_WARNING_DAYS=3

# Observability
# Leave empty to expose /metrics without auth (not recommended).
METRICS_TOKEN=
# Optional event push to vmagent Prometheus importer.
EVENT_METRICS_PUSH_ENABLED=false
# Example: http://127.0.0.1:8429/api/v1/import/prometheus
EVENT_METRICS_PUSH_URL=
EVENT_METRICS_PUSH_METRIC_NAME=blackwall_event
EVENT_METRICS_PUSH_TIMEOUT_MS=250
EVENT_METRICS_PUSH_INCLUDE_OUTCOME=true
# Comma-separated label pairs, e.g. environment=production,instance=blackwall-1
EVENT_METRICS_PUSH_STATIC_LABELS=

# Error trace encryption key (base64 of 32 random bytes).
# If empty, CSRF_SECRET-derived key is used.
ERROR_TRACE_KEY=

# Optional detached signature key for audit CSV exports.
# Generate: openssl rand -base64 32
AUDIT_EXPORT_SIGNING_KEY=

# Project licensing. Mount this key file read-only with mode 0600. The key
# itself must never be stored in an environment variable.
LICENCE_SIGNING_KEY_FILE=
LICENCE_MAX_VALIDITY_DAYS=365
LICENCE_CLOCK_SKEW_SECONDS=120
LICENCE_ONLINE_CHECK_SECONDS=86400
LICENCE_REMINDERS_ENABLED=false
LICENCE_REMINDER_INTERVAL_SECONDS=900
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Blackwall
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10

# Cryptbin
# Must be outside public_html and writable by the PHP process.
CRYPTBIN_STORAGE_PATH=/var/lib/blackwall/cryptbin
CRYPTBIN_MAX_UPLOAD_BYTES=5242880
CRYPTBIN_MAX_TEXT_BYTES=262144
# Optional comma-separated allow-list, leave blank for unrestricted.
CRYPTBIN_ALLOWED_MIME=
# Optional default retention; 0 disables automatic expiry.
CRYPTBIN_DEFAULT_RETENTION_DAYS=0
