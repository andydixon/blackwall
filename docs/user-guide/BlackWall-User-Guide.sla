                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• blackwall_webhook_endpoint — webhook receiver registration with HMAC secret."/>
                <para ALIGN="0" LINESP="13"/>
