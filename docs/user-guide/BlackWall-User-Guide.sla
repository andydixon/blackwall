                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Admin API tokens are bearer credentials for /api/v1/*, the SCIM 2.0 surface, and the Terraform provider."/>
