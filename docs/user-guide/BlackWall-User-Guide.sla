        <PAGEOBJECT XPOS="152" YPOS="58458.2" OwnPage="131" ItemID="1987197110" PTYPE="4" WIDTH="476.28" HEIGHT="322" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 322 L0 322 L0 0 Z" copath="M0 0 L476.28 0 L476.28 322 L0 322 L0 0 Z" gXpos="152" gYpos="58458.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="10.2" FONT="Noto Sans Mono Regular" FONTSIZE="7.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Key  |  Default  |  Purpose"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="licence_signing_key_file  |  (empty)  |  Mode-0600 Ed25519 PKCS#8 key path. Empty disables issuance but not verification or revocation."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="licence_max_validity_days  |  365  |  Maximum validity accepted when issuing; range 1–3650."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="licence_clock_skew_seconds  |  120  |  Verification tolerance; range 0–600."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="licence_online_check_seconds  |  86400  |  Signed maximum interval between authoritative revocation checks; range 300–604800."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="licence_reminders_enabled  |  false  |  Enables the durable 30/14/7/2/1-day renewal reminder worker; valid encrypted SMTP configuration is then required."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="licence_reminder_interval_seconds  |  900  |  Queue and delivery scan interval; range 300–86400."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="smtp_host / smtp_port  |  (empty) / 587  |  SMTP submission endpoint without a URL scheme."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="smtp_username / smtp_password  |  (empty)  |  Optional credential pair; set both or neither and inject the password from the deployment secret store."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="smtp_from_address / smtp_from_name  |  (empty) / Blackwall  |  Plain sender mailbox and human-readable name."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="smtp_tls_mode  |  starttls  |  Mandatory encrypted transport: starttls or implicit; plaintext mode is not supported."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="smtp_timeout_seconds  |  10  |  Per-connection network deadline; range 1–60."/>
                <trail ALIGN="0" LINESP="10.2"/>
            </StoryText>
        </PAGEOBJECT>
