        <PAGEOBJECT XPOS="762" YPOS="48611" OwnPage="110" ItemID="1967728918" PTYPE="4" WIDTH="476.28" HEIGHT="39" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 39 L0 39 L0 0 Z" copath="M0 0 L476.28 0 L476.28 39 L0 39 L0 0 Z" gXpos="762" gYpos="48611" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
