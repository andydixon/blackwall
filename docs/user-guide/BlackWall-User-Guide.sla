                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Organisations are the tenant boundary. Use them to keep one customer's data away from another's, to apply distinct branding, and to scope admin role assignments."/>
