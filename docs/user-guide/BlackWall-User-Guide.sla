                <DefaultStyle ALIGN="0" LINESP="30" FONT="Lato Bold" FONTSIZE="25"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="25" FCOLOR="GuideInk" CH="Architecture at a Glance"/>
