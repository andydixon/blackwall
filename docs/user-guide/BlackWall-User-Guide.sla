        <PAGEOBJECT XPOS="762" YPOS="31022" OwnPage="70" ItemID="1917321574" PTYPE="6" WIDTH="68" HEIGHT="4" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideBlue" PCOLOR2="GuideBlue" PLINEART="1" path="M0 0 L68 0 L68 4 L0 4 L0 0 Z" copath="M0 0 L68 0 L68 4 L0 4 L0 0 Z" gXpos="762" gYpos="31022" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="762" YPOS="31047" OwnPage="70" ItemID="1917350918" PTYPE="4" WIDTH="476.28" HEIGHT="30.2" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 30.2 L0 30.2 L0 0 Z" copath="M0 0 L476.28 0 L476.28 30.2 L0 30.2 L0 0 Z" gXpos="762" gYpos="31047" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="There are three viable patterns for integrating Blackwall into a web application. Pick on the basis of where your code runs."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31084.2" OwnPage="70" ItemID="1917508262" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="31084.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17" FONT="Lato Bold" FONTSIZE="13"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="Pattern A — Server-Side Web Application"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31116.2" OwnPage="70" ItemID="1917575174" PTYPE="4" WIDTH="476.28" HEIGHT="17.1" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" copath="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" gXpos="762" gYpos="31116.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Use when:"/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31140.3" OwnPage="70" ItemID="1917537606" PTYPE="4" WIDTH="476.28" HEIGHT="30" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 30 L0 30 L0 0 Z" copath="M0 0 L476.28 0 L476.28 30 L0 30 L0 0 Z" gXpos="762" gYpos="31140.3" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13" FONT="Lato Regular" FONTSIZE="9.1"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• Your application has a server-side component (Express, Flask, PHP, Go HTTP server, ASP.NET)."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• You want the simplest, most secure path."/>
                <trail ALIGN="0" LINESP="13"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31178.3" OwnPage="70" ItemID="1917653654" PTYPE="4" WIDTH="476.28" HEIGHT="43.3" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" copath="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" gXpos="762" gYpos="31178.3" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The server holds the client_secret, performs the token exchange, sets a session cookie, and shows authenticated pages directly. The browser never sees the access token. Most legitimate websites should use this pattern."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31228.6" OwnPage="70" ItemID="1917886534" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="31228.6" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17" FONT="Lato Bold" FONTSIZE="13"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="Pattern B — Single-Page Application"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31260.6" OwnPage="70" ItemID="1917864774" PTYPE="4" WIDTH="476.28" HEIGHT="17.1" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" copath="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" gXpos="762" gYpos="31260.6" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Use when:"/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31284.7" OwnPage="70" ItemID="1917923110" PTYPE="4" WIDTH="476.28" HEIGHT="30" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 30 L0 30 L0 0 Z" copath="M0 0 L476.28 0 L476.28 30 L0 30 L0 0 Z" gXpos="762" gYpos="31284.7" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13" FONT="Lato Regular" FONTSIZE="9.1"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• Your application is a pure browser SPA (React, Vue, Svelte) with no server-side component you control."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• The user's browser is the only place your code runs."/>
                <trail ALIGN="0" LINESP="13"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31322.7" OwnPage="70" ItemID="1918053254" PTYPE="4" WIDTH="476.28" HEIGHT="43.3" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" copath="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" gXpos="762" gYpos="31322.7" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="You cannot keep a client secret. Use a public client type with PKCE. Store the access token in memory only (not localStorage, not cookies) and request a new token when the user reloads. Send the access token in Authorization: Bearer to your APIs."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31373" OwnPage="70" ItemID="1918279782" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="31373" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17" FONT="Lato Bold" FONTSIZE="13"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="Pattern C — Backend-for-Frontend (BFF)"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31405" OwnPage="70" ItemID="1918257494" PTYPE="4" WIDTH="476.28" HEIGHT="17.1" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" copath="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" gXpos="762" gYpos="31405" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Use when:"/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31429.1" OwnPage="70" ItemID="1918359078" PTYPE="4" WIDTH="476.28" HEIGHT="43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 43 L0 43 L0 0 Z" copath="M0 0 L476.28 0 L476.28 43 L0 43 L0 0 Z" gXpos="762" gYpos="31429.1" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13" FONT="Lato Regular" FONTSIZE="9.1"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• You have an SPA frontend but you also control a backend (e.g. a thin Node or Go service in front of microservices)."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• You want the SPA's simplicity but the security of a confidential client."/>
                <trail ALIGN="0" LINESP="13"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31480.1" OwnPage="70" ItemID="1918440806" PTYPE="4" WIDTH="476.28" HEIGHT="43.3" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" copath="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" gXpos="762" gYpos="31480.1" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The backend acts as a confidential client. It holds the secret, exchanges the code, and exposes a session cookie to the SPA. APIs the SPA calls are proxied through the BFF, which attaches the access token on the SPA's behalf. This is widely considered the modern best practice."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="31530.4" OwnPage="70" ItemID="1918646342" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="31530.4" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17" FONT="Lato Bold" FONTSIZE="13"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="Comparison"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
