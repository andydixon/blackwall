            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="596.28" YPOS="42284.89" OwnPage="93" ItemID="1947294438" PTYPE="4" WIDTH="32" HEIGHT="14" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L32 0 L32 14 L0 14 L0 0 Z" copath="M0 0 L32 0 L32 14 L0 14 L0 0 Z" gXpos="596.28" gYpos="42284.89" gWidth="0" gHeight="0" ALIGN="2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
