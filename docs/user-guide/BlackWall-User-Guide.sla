                <DefaultStyle ALIGN="0" LINESP="13" FONT="Lato Regular" FONTSIZE="9.1"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• View the OAuth client count, assignment count, and privilege count."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• Open the Auth sandbox to preview userinfo responses (Part IV, Chapter 8)."/>
                <para ALIGN="0" LINESP="13"/>
