        <PAGEOBJECT XPOS="762" YPOS="49544" OwnPage="112" ItemID="1970579158" PTYPE="6" WIDTH="68" HEIGHT="4" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideBlue" PCOLOR2="GuideBlue" PLINEART="1" path="M0 0 L68 0 L68 4 L0 4 L0 0 Z" copath="M0 0 L68 0 L68 4 L0 4 L0 0 Z" gXpos="762" gYpos="49544" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="762" YPOS="49569" OwnPage="112" ItemID="1970597750" PTYPE="4" WIDTH="476.28" HEIGHT="342.4" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 342.4 L0 342.4 L0 0 Z" copath="M0 0 L476.28 0 L476.28 342.4 L0 342.4 L0 0 Z" gXpos="762" gYpos="49569" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="10.2" FONT="Noto Sans Mono Regular" FONTSIZE="7.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Symptom  |  Diagnosis"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Blackwall refuses to start with config: session_secret must be at least 32 characters  |  Generate proper secrets (openssl rand -hex 32). Refuses by design — running with weak material is worse than not running."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Login page shows but WebAuthn prompt never appears  |  Browser blocks WebAuthn outside HTTPS. Verify TLS at the proxy. Verify webauthn_rp_id matches the hostname."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Users sign in but immediately see access_denied at a downstream client  |  The user is not assigned to that project. Open /admin/projects/{uuid}/assignments."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="ID tokens fail nonce check  |  Your application's pre-auth session is being lost between redirect and callback. Check cookie SameSite and the Secure attribute."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="/metrics returns 401  |  Set metrics_token in config.yaml and send Authorization: Bearer &lt;token&gt;."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Webhook receiver never sees deliveries  |  Confirm the project's webhooks_enabled flag is on. Check /admin/projects/{uuid}/webhooks/{id}/deliveries for failed attempts. If the endpoint is auto-disabled (20 consecutive failures), re-enable it."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Audit chain verify reports drift  |  Stop further writes operationally. The first bad row's ID is the boundary. Investigate from git log who last touched the database."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Tokens verify locally but /oauth/introspect says inactive  |  The token was revoked. JWT signature validity ≠ token validity. Add introspection to your verification loop, or switch to opaque tokens."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="New project shows enterprise features off  |  Migration backfilled existing projects with everything off. Turn on the relevant flags on the project's detail page."/>
                <trail ALIGN="0" LINESP="10.2"/>
            </StoryText>
        </PAGEOBJECT>
