        <PAGEOBJECT XPOS="762" YPOS="41606" OwnPage="94" ItemID="1948683926" PTYPE="6" WIDTH="68" HEIGHT="4" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideBlue" PCOLOR2="GuideBlue" PLINEART="1" path="M0 0 L68 0 L68 4 L0 4 L0 0 Z" copath="M0 0 L68 0 L68 4 L0 4 L0 0 Z" gXpos="762" gYpos="41606" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="762" YPOS="41631" OwnPage="94" ItemID="1948710630" PTYPE="4" WIDTH="476.28" HEIGHT="56.4" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 56.4 L0 56.4 L0 0 Z" copath="M0 0 L476.28 0 L476.28 56.4 L0 56.4 L0 0 Z" gXpos="762" gYpos="41631" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="SCIM 2.0 (RFC 7643 + RFC 7644) is the standard upstream identity providers (Workday, Okta, Entra ID, Google Workspace, BambooHR, Rippling) use to push user-lifecycle changes into downstream applications. Blackwall exposes /scim/v2/Users so any of these can provision, update, and deprovision users without an operator copying them by hand."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="41694.4" OwnPage="94" ItemID="1948851878" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="41694.4" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17" FONT="Lato Bold" FONTSIZE="13"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="Base URL and authentication"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="41726.4" OwnPage="94" ItemID="1948966454" PTYPE="4" WIDTH="476.28" HEIGHT="97.6" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 97.6 L0 97.6 L0 0 Z" copath="M0 0 L476.28 0 L476.28 97.6 L0 97.6 L0 0 Z" gXpos="762" gYpos="41726.4" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="10.2" FONT="Noto Sans Mono Regular" FONTSIZE="7.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Item  |  Value"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Base URL  |  https://auth.example.com/scim/v2"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Auth  |  Authorization: Bearer bw_admin_… (Part VIII, Chapter 2)"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Target project  |  X-BlackWall-Project: &lt;project-uuid&gt; header"/>
                <trail ALIGN="0" LINESP="10.2"/>
            </StoryText>
        </PAGEOBJECT>
