                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Use this only when you have no server-side component. The flow is the same as Pattern A but every step happens in the browser."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="32879.2" OwnPage="74" ItemID="1922027830" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="32879.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17" FONT="Lato Bold" FONTSIZE="13"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="Storage rules"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="32911.2" OwnPage="74" ItemID="1922074646" PTYPE="4" WIDTH="476.28" HEIGHT="95" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 95 L0 95 L0 0 Z" copath="M0 0 L476.28 0 L476.28 95 L0 95 L0 0 Z" gXpos="762" gYpos="32911.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13" FONT="Lato Regular" FONTSIZE="9.1"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• Access token — store in JavaScript memory only (a closure variable, or a service worker). When the user reloads the page, you lose it and must redirect for a fresh authorisation. This is correct."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• Refresh tokens — Blackwall issues these only when offline_access is requested. For SPAs, prefer to not request offline_access and instead use silent re-authentication via prompt=none to obtain new tokens when the access token expires. Refresh tokens in browser storage are an attractive target for XSS."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• State and PKCE verifier — store in sessionStorage for the duration of the redirect. They are not security-critical to hide; they only need to survive the redirect."/>
                <trail ALIGN="0" LINESP="13"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="33014.2" OwnPage="74" ItemID="1922490182" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="33014.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17" FONT="Lato Bold" FONTSIZE="13"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="Silent re-authentication"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="33046.2" OwnPage="74" ItemID="1922532550" PTYPE="4" WIDTH="476.28" HEIGHT="17.1" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" copath="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" gXpos="762" gYpos="33046.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
