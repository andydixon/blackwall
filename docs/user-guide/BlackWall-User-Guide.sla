        <PAGEOBJECT XPOS="762" YPOS="8503.775" OwnPage="18" ItemID="1825432614" PTYPE="4" WIDTH="476.28" HEIGHT="58" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 58 L0 58 L0 0 Z" copath="M0 0 L476.28 0 L476.28 58 L0 58 L0 0 Z" gXpos="762" gYpos="8503.775" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="9" FONT="Noto Sans Mono Regular" FONTSIZE="6.8"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="CREATE DATABASE blackwall CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="CREATE USER 'blackwall'@'%' IDENTIFIED BY 'long-random-string-here';"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="GRANT ALL PRIVILEGES ON blackwall.* TO 'blackwall'@'%';"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="FLUSH PRIVILEGES;"/>
                <trail ALIGN="0" LINESP="9"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="8571.775" OwnPage="18" ItemID="1825610630" PTYPE="4" WIDTH="476.28" HEIGHT="69.5" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 69.5 L0 69.5 L0 0 Z" copath="M0 0 L476.28 0 L476.28 69.5 L0 69.5 L0 0 Z" gXpos="762" gYpos="8571.775" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Blackwall applies its forward-only migrations automatically, but the current distribution expects the established Blackwall base schema to exist first. The source tree does not contain a fresh-install baseline SQL file, so do not point the binary at an unrelated empty schema. Restore the baseline from an existing Blackwall deployment or obtain the deployment-specific baseline before first start, then let the binary apply the numbered migrations in internal/db/migrations.go."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
