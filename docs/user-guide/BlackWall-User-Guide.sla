        <PAGEOBJECT XPOS="762" YPOS="24355.675" OwnPage="54" ItemID="1897078054" PTYPE="4" WIDTH="476.28" HEIGHT="128.2" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 128.2 L0 128.2 L0 0 Z" copath="M0 0 L476.28 0 L476.28 128.2 L0 128.2 L0 0 Z" gXpos="762" gYpos="24355.675" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="10.2" FONT="Noto Sans Mono Regular" FONTSIZE="7.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Type  |  When to choose  |  Token endpoint authentication"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Confidential  |  Server-side applications that can keep a secret (Go services, PHP backends, server-side rendered apps).  |  client_secret_basic or client_secret_post."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Public  |  Browser SPAs and native mobile/desktop apps that cannot keep a secret.  |  none — security comes entirely from PKCE."/>
                <trail ALIGN="0" LINESP="10.2"/>
            </StoryText>
        </PAGEOBJECT>
