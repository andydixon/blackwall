        <PAGEOBJECT XPOS="762" YPOS="35580" OwnPage="80" ItemID="1928859590" PTYPE="4" WIDTH="476.28" HEIGHT="499" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 499 L0 499 L0 0 Z" copath="M0 0 L476.28 0 L476.28 499 L0 499 L0 0 Z" gXpos="762" gYpos="35580" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="9" FONT="Noto Sans Mono Regular" FONTSIZE="6.8"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="# app.py"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="import os"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="from flask import Flask, redirect, session, url_for"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="from authlib.integrations.flask_client import OAuth"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="app = Flask(__name__)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="app.secret_key = os.environ['SESSION_SECRET']"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="app.config.update("/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    SESSION_COOKIE_HTTPONLY=True,"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    SESSION_COOKIE_SECURE=True,"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    SESSION_COOKIE_SAMESITE='Lax',"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH=")"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="oauth = OAuth(app)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="oauth.register("/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    name='blackwall',"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    client_id=os.environ['BW_CLIENT_ID'],"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    client_secret=os.environ['BW_CLIENT_SECRET'],"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    server_metadata_url=f&quot;{os.environ['BW_ISSUER']}/.well-known/openid-configuration&quot;,"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    client_kwargs={"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        'scope': 'openid profile email',"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        'code_challenge_method': 'S256',"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    },"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH=")"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="@app.route('/auth/login')"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="def login():"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    redirect_uri = url_for('callback', _external=True)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    return oauth.blackwall.authorize_redirect(redirect_uri)"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="@app.route('/auth/callback')"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="def callback():"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    token = oauth.blackwall.authorize_access_token()"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    user = token.get('userinfo')"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    session['user'] = {"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        'sub': user['sub'],"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        'email': user.get('email'),"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        'name': user.get('name'),"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    }"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    return redirect('/')"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="@app.route('/auth/logout', methods=['POST'])"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="def logout():"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    session.pop('user', None)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    return redirect('/')"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="@app.route('/')"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="def home():"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    user = session.get('user')"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    if not user:"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        return '&lt;a href=&quot;/auth/login&quot;&gt;Sign in&lt;/a&gt;'"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    return (f'&lt;p&gt;Hello, {user[&quot;name&quot;]}&lt;/p&gt;'"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="            '&lt;form method=&quot;POST&quot; action=&quot;/auth/logout&quot;&gt;'"/>
                <trail ALIGN="0" LINESP="9"/>
            </StoryText>
        </PAGEOBJECT>
