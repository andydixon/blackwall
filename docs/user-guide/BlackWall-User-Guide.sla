        <PAGEOBJECT XPOS="762" YPOS="57945.2" OwnPage="130" ItemID="1986498422" PTYPE="4" WIDTH="476.28" HEIGHT="118" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 118 L0 118 L0 0 Z" copath="M0 0 L476.28 0 L476.28 118 L0 118 L0 0 Z" gXpos="762" gYpos="57945.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="10.2" FONT="Noto Sans Mono Regular" FONTSIZE="7.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Key  |  Default  |  Purpose"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="webauthn_rp_id  |  derived from app_url  |  Relying party ID. Must match the public hostname."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="webauthn_rp_name  |  BlackWall OAuth  |  Display name in WebAuthn prompts."/>
                <para ALIGN="0" LINESP="10.2"/>
