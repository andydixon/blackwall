                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Your website needs three endpoints:"/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="32167.2" OwnPage="72" ItemID="1920117542" PTYPE="4" WIDTH="476.28" HEIGHT="138.4" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 138.4 L0 138.4 L0 0 Z" copath="M0 0 L476.28 0 L476.28 138.4 L0 138.4 L0 0 Z" gXpos="762" gYpos="32167.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="10.2" FONT="Noto Sans Mono Regular" FONTSIZE="7.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Endpoint  |  Purpose"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="GET /auth/login  |  Generate PKCE pair + state + nonce; stash them in the session; redirect to /oauth/authorize."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="GET /auth/callback  |  Verify state; exchange code for tokens; verify ID token; create a local session; redirect to the post-login page."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="POST /auth/logout  |  Destroy the local session; optionally revoke the access token; redirect home."/>
                <trail ALIGN="0" LINESP="10.2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="32314.6" OwnPage="72" ItemID="1920383894" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="32314.6" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17" FONT="Lato Bold" FONTSIZE="13"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="State and nonce handling"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="32346.6" OwnPage="72" ItemID="1920362214" PTYPE="4" WIDTH="476.28" HEIGHT="69" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 69 L0 69 L0 0 Z" copath="M0 0 L476.28 0 L476.28 69 L0 69 L0 0 Z" gXpos="762" gYpos="32346.6" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13" FONT="Lato Regular" FONTSIZE="9.1"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• state — a random string the client generates and stores in the session before redirecting. After the callback, the client checks that the returned state matches. Defeats CSRF on the redirect."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• nonce — a random string included in the authorisation request and echoed in the ID token. After exchange, the client checks that the ID token's nonce claim matches. Defeats token-injection attacks where an attacker tries to splice their authorisation response into the victim's session."/>
                <trail ALIGN="0" LINESP="13"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="32423.6" OwnPage="72" ItemID="1920714246" PTYPE="4" WIDTH="476.28" HEIGHT="30.2" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 30.2 L0 30.2 L0 0 Z" copath="M0 0 L476.28 0 L476.28 30.2 L0 30.2 L0 0 Z" gXpos="762" gYpos="32423.6" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Both must be at least 16 random bytes. Both must be remembered for the duration of the redirect (typically by storing in the user's pre-auth cookie session)."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="32460.8" OwnPage="72" ItemID="1920854502" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="32460.8" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
