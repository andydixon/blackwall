        <PAGEOBJECT XPOS="167" YPOS="40649" OwnPage="91" ItemID="1945262742" PTYPE="4" WIDTH="476.28" HEIGHT="43.3" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" copath="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" gXpos="167" gYpos="40649" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The fastest way to confirm &quot;what claims will my application actually see?&quot; is the per-project sandbox at /admin/projects/{uuid}/test. Pick the user you intend to test as, pick your scopes, run the preview. The resulting JSON is byte-identical to what /oauth/userinfo would return in a real flow."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
