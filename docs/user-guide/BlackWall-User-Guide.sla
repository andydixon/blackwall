                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="PLUGIN_DIR=&quot;$HOME/.terraform.d/plugins/blackwall.io/identity/blackwall/0.1.0/$(go env GOOS)_$(go env "/>
                <para ALIGN="0" LINESP="9"/>
