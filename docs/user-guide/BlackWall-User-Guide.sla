                <DefaultStyle ALIGN="2" LINESP="8" FONT="Lato Regular" FONTSIZE="6.8"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="6.8" FCOLOR="GuideMuted" CH="PART V — INTEGRATING BLACKWALL INTO YOUR WEBSITE"/>
                <trail ALIGN="2" LINESP="8"/>
            </StoryText>
        </PAGEOBJECT>
