                <DefaultStyle ALIGN="0" LINESP="13" FONT="Lato Regular" FONTSIZE="9.1"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• blackwall_project — full create / read / update / delete lifecycle."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• blackwall_oauth_client — full CRUD; client_secret returned once at create."/>
                <para ALIGN="0" LINESP="13"/>
