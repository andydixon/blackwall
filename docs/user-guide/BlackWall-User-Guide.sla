        <PAGEOBJECT XPOS="762" YPOS="19481" OwnPage="44" ItemID="1874511494" PTYPE="4" WIDTH="476.28" HEIGHT="103" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 103 L0 103 L0 0 Z" copath="M0 0 L476.28 0 L476.28 103 L0 103 L0 0 Z" gXpos="762" gYpos="19481" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="9" FONT="Noto Sans Mono Regular" FONTSIZE="6.8"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="})"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="req, _ := http.NewRequestWithContext(ctx, http.MethodPost,"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    &quot;https://blackwall.cx/licences/v1/verify&quot;, bytes.NewReader(payload))"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="req.Header.Set(&quot;Content-Type&quot;, &quot;application/json&quot;)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="resp, err := http.DefaultClient.Do(req)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="if err != nil || resp.StatusCode != http.StatusOK { deny() }"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="var result struct { Valid bool `json:&quot;valid&quot;`; Code string `json:&quot;code&quot;` }"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="if json.NewDecoder(io.LimitReader(resp.Body, 64&lt;&lt;10)).Decode(&amp;result) != nil ||"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    !result.Valid || result.Code != &quot;valid&quot; { deny() }"/>
                <trail ALIGN="0" LINESP="9"/>
            </StoryText>
        </PAGEOBJECT>
