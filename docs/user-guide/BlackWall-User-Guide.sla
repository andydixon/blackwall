                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="Tracing what Blackwall thinks happened"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="40362.6" OwnPage="90" ItemID="1944829350" PTYPE="4" WIDTH="476.28" HEIGHT="17.1" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" copath="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" gXpos="762" gYpos="40362.6" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Every OAuth-relevant event is logged. To trace a specific user's failed sign-in:"/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="40386.7" OwnPage="90" ItemID="1944906886" PTYPE="4" WIDTH="476.28" HEIGHT="56" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 56 L0 56 L0 0 Z" copath="M0 0 L476.28 0 L476.28 56 L0 56 L0 0 Z" gXpos="762" gYpos="40386.7" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13" FONT="Lato Regular" FONTSIZE="9.1"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="1. Note the approximate time and your IP."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="2. Open /admin/audit."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="3. Filter on event_type containing oauth and on your IP."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="4. Look at metadata_json for the failure reason on oauth.*.fail rows."/>
                <trail ALIGN="0" LINESP="13"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="40450.7" OwnPage="90" ItemID="1945004006" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="40450.7" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
