                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• Manage Default OIDC claims (Part IV, Chapter 6)."/>
                <trail ALIGN="0" LINESP="13"/>
