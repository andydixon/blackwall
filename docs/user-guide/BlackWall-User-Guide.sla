                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Blackwall fans every project-scoped audit event out to registered webhook receivers. The dispatcher runs in the background; the originating HTTP request never blocks on a downstream callout."/>
