        <PAGEOBJECT XPOS="152" YPOS="20759.1" OwnPage="45" ItemID="1878310710" PTYPE="4" WIDTH="476.28" HEIGHT="30.2" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 30.2 L0 30.2 L0 0 Z" copath="M0 0 L476.28 0 L476.28 30.2 L0 30.2 L0 0 Z" gXpos="152" gYpos="20759.1" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="closed on TLS, network, parsing, time, issuer, project, hostname, signature, feature, instance, key-status, database, revocation, or response-freshness failure."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="152" YPOS="20796.3" OwnPage="45" ItemID="1878350726" PTYPE="4" WIDTH="476.28" HEIGHT="56.4" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 56.4 L0 56.4 L0 0 Z" copath="M0 0 L476.28 0 L476.28 56.4 L0 56.4 L0 0 Z" gXpos="152" gYpos="20796.3" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Never ship the licence issuer's private signing key, a symmetric ‘licence secret’, or licence-minting code in the product being licensed. A hostile owner of a distributed binary may still patch its policy checks, so combine licence verification with server-side entitlements for high-value operations where that threat matters."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
