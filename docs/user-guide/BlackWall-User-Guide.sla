            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="9" FONT="Noto Sans Mono Regular" FONTSIZE="6.8"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="// main.go"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="package main"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="import ("/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    &quot;context&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    &quot;crypto/rand&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    &quot;encoding/base64&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    &quot;encoding/json&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    &quot;log&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    &quot;net/http&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    &quot;os&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    &quot;github.com/coreos/go-oidc/v3/oidc&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    &quot;golang.org/x/oauth2&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH=")"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="var ("/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    provider *oidc.Provider"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    config   oauth2.Config"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    verifier *oidc.IDTokenVerifier"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH=")"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="func init() {"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    ctx := context.Background()"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    var err error"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    provider, err = oidc.NewProvider(ctx, os.Getenv(&quot;BW_ISSUER&quot;))"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    if err != nil {"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        log.Fatal(err)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    }"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    config = oauth2.Config{"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        ClientID:     os.Getenv(&quot;BW_CLIENT_ID&quot;),"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        ClientSecret: os.Getenv(&quot;BW_CLIENT_SECRET&quot;),"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        RedirectURL:  os.Getenv(&quot;BW_REDIRECT_URI&quot;),"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        Endpoint:     provider.Endpoint(),"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="        Scopes:       []string{oidc.ScopeOpenID, &quot;profile&quot;, &quot;email&quot;},"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    }"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    verifier = provider.Verifier(&amp;oidc.Config{ClientID: config.ClientID})"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="}"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="func randStr(n int) string {"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    b := make([]byte, n)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    rand.Read(b)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    return base64.RawURLEncoding.EncodeToString(b)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="}"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="func login(w http.ResponseWriter, r *http.Request) {"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    state := randStr(16)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    nonce := randStr(16)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    verifierStr := randStr(32)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    challenge := oauth2.S256ChallengeFromVerifier(verifierStr)"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    http.SetCookie(w, &amp;http.Cookie{Name: &quot;state&quot;, Value: state, HttpOnly: true, Secure: true, SameSite: "/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  ↳ http.SameSiteLaxMode, Path: &quot;/&quot;})"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    http.SetCookie(w, &amp;http.Cookie{Name: &quot;nonce&quot;, Value: nonce, HttpOnly: true, Secure: true, SameSite: "/>
                <trail ALIGN="0" LINESP="9"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="152" YPOS="38749.89" OwnPage="85" ItemID="1922909222" PTYPE="5" WIDTH="476.28" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" PWIDTH="0.5" SHADE="nan" PCOLOR2="GuideRule" PLINEART="1" path="" gXpos="152" gYpos="38749.89" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="152" YPOS="38756.89" OwnPage="85" ItemID="1935770294" PTYPE="4" WIDTH="441.28" HEIGHT="14" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L441.28 0 L441.28 14 L0 14 L0 0 Z" copath="M0 0 L441.28 0 L441.28 14 L0 14 L0 0 Z" gXpos="152" gYpos="38756.89" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
