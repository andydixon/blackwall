        </PAGEOBJECT>
        <PAGEOBJECT XPOS="152" YPOS="27589.4" OwnPage="61" ItemID="1909608822" PTYPE="4" WIDTH="476.28" HEIGHT="67" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 67 L0 67 L0 0 Z" copath="M0 0 L476.28 0 L476.28 67 L0 67 L0 0 Z" gXpos="152" gYpos="27589.4" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="9" FONT="Noto Sans Mono Regular" FONTSIZE="6.8"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="POST /oauth/token"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="Content-Type: application/x-www-form-urlencoded"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="Authorization: Basic &lt;base64(client_id:client_secret)&gt;"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="grant_type=refresh_token&amp;refresh_token=rt_…"/>
                <trail ALIGN="0" LINESP="9"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="152" YPOS="27666.4" OwnPage="61" ItemID="1909838742" PTYPE="4" WIDTH="476.28" HEIGHT="82.6" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 82.6 L0 82.6 L0 0 Z" copath="M0 0 L476.28 0 L476.28 82.6 L0 82.6 L0 0 Z" gXpos="152" gYpos="27666.4" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The response carries a new access token and a new refresh token. The old refresh token is immediately revoked. Re-using a revoked refresh token triggers token-family revocation: every active access and refresh token for that user/project/client triple is revoked. This is the OAuth 2.1 best-practice that defeats stolen refresh tokens. When an OIDC refresh response includes a new ID token, its auth_time remains the original authentication time; token refresh does not pretend that the user performed a new passkey check."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="28165.89" OwnPage="62" ItemID="1907289030" PTYPE="5" WIDTH="476.28" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" PWIDTH="0.5" SHADE="nan" PCOLOR2="GuideRule" PLINEART="1" path="" gXpos="762" gYpos="28165.89" gWidth="0" gHeight="0" LAYER="0"/>
