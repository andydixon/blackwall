        <PAGEOBJECT XPOS="762" YPOS="6431.2" OwnPage="14" ItemID="1819066934" PTYPE="4" WIDTH="476.28" HEIGHT="138.4" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 138.4 L0 138.4 L0 0 Z" copath="M0 0 L476.28 0 L476.28 138.4 L0 138.4 L0 0 Z" gXpos="762" gYpos="6431.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
