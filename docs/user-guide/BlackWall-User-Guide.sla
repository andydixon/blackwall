        <PAGEOBJECT XPOS="762" YPOS="17073.4" OwnPage="38" ItemID="1864045222" PTYPE="4" WIDTH="476.28" HEIGHT="199.6" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 199.6 L0 199.6 L0 0 Z" copath="M0 0 L476.28 0 L476.28 199.6 L0 199.6 L0 0 Z" gXpos="762" gYpos="17073.4" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="10.2" FONT="Noto Sans Mono Regular" FONTSIZE="7.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Flag  |  Effect"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="webhooks_enabled  |  Gates the outbound webhook dispatcher. Endpoints can be registered while off; nothing is delivered until on."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="db_sessions_enabled  |  Records each authenticated session in user_sessions so it can be revoked server-side."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="max_concurrent_sessions  |  When greater than zero and DB sessions are on, caps a user to N parallel sessions across this project. A login exceeding N revokes the oldest session first. Zero means unbounded."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="custom_branding_enabled  |  Pulls the organisation's branding overlay onto login screens served for this project."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="step_up_required  |  Reserved for the upcoming step-up auth surface (forces a fresh WebAuthn touch for high-impact actions). Off by default."/>
                <trail ALIGN="0" LINESP="10.2"/>
            </StoryText>
        </PAGEOBJECT>
