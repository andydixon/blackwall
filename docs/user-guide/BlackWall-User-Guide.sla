        <PAGEOBJECT XPOS="762" YPOS="5825.775" OwnPage="12" ItemID="1817899622" PTYPE="4" WIDTH="476.28" HEIGHT="82" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 82 L0 82 L0 0 Z" copath="M0 0 L476.28 0 L476.28 82 L0 82 L0 0 Z" gXpos="762" gYpos="5825.775" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13" FONT="Lato Regular" FONTSIZE="9.1"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• Every user registers one or more passkeys (platform authenticator, security key, or a synced passkey provider)."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• Each authentication assertion requires both the User Present (UP) and User Verification (UV) flags. PIN-less or touch-less authenticators are rejected."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• Sign-counter regression is treated as a cloned-credential indicator and the assertion is refused."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• Passwords cannot be enabled."/>
                <trail ALIGN="0" LINESP="13"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="5915.775" OwnPage="12" ItemID="1818113590" PTYPE="4" WIDTH="476.28" HEIGHT="30.2" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 30.2 L0 30.2 L0 0 Z" copath="M0 0 L476.28 0 L476.28 30.2 L0 30.2 L0 0 Z" gXpos="762" gYpos="5915.775" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The first user — the bootstrap super-administrator — is created at install time with a one-time enrolment link. All subsequent users follow the same enrolment process."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
