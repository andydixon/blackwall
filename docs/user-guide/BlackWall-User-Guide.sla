            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The normative protocol, validation sequence, anti-spoofing requirements, key rotation and compromise response, and language examples live in Verifying Blackwall Project Licences (licensing/VERIFYING_LICENCES.md). Keep that guide with the application integration; a licence must never be accepted merely because its JSON decodes successfully."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="61980.4" OwnPage="140" ItemID="1995385718" PTYPE="4" WIDTH="476.28" HEIGHT="43.3" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" copath="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" gXpos="762" gYpos="61980.4" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The authoritative verifier is https://blackwall.cx/licences/v1/verify for licences whose signed issuer is https://blackwall.cx. Self-hosted issuers must use their own fixed app_url; consumers must not take the expected issuer from the unverified licence itself."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
