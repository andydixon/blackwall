        <PAGEOBJECT XPOS="762" YPOS="10785.1" OwnPage="24" ItemID="1834782838" PTYPE="4" WIDTH="476.28" HEIGHT="291.4" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 291.4 L0 291.4 L0 0 Z" copath="M0 0 L476.28 0 L476.28 291.4 L0 291.4 L0 0 Z" gXpos="762" gYpos="10785.1" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="10.2" FONT="Noto Sans Mono Regular" FONTSIZE="7.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Check  |  How"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Audit chain is being written  |  Open /admin/audit. Each row should carry a non-empty chain_hash. Empty hashes indicate database write failures."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="HSTS is being emitted  |  curl -sI https://auth.example.com/ and look for Strict-Transport-Security."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Rate limiting is on  |  for i in $(seq 1 200); do curl -s -o /dev/null https://auth.example.com/oauth/authorize; done should start returning HTTP 429 within a few seconds."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Maintenance jobs run cleanly  |  Visit /admin/maintenance and click Run now. All jobs should land at success."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="The OIDC discovery doc is well-formed  |  curl -s https://auth.example.com/.well-known/openid-configuration  |  jq should return a populated JSON document."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="JWKS is reachable  |  curl -s https://auth.example.com/oauth/jwks  |  jq '.keys  |  length' should return at least 1."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Build provenance is present  |  On the admin dashboard, confirm the application version, commit, build time, last successful vulnerability-scan time, and opaque scan reference match the release you intended to deploy."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Backup of the MySQL database is scheduled  |  Confirm with your infrastructure team. The JWT signing keys live in the database."/>
                <trail ALIGN="0" LINESP="10.2"/>
            </StoryText>
        </PAGEOBJECT>
