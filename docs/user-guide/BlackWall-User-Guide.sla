                <ITEXT FONT="Lato Bold" FONTSIZE="6.2" FCOLOR="GuideBlue" CH="HCL"/>
                <trail ALIGN="0" LINESP="7"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="152" YPOS="25062.2" OwnPage="55" ItemID="1898500022" PTYPE="4" WIDTH="476.28" HEIGHT="211" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 211 L0 211 L0 0 Z" copath="M0 0 L476.28 0 L476.28 211 L0 211 L0 0 Z" gXpos="152" gYpos="25062.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="9" FONT="Noto Sans Mono Regular" FONTSIZE="6.8"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="resource &quot;blackwall_oauth_client&quot; &quot;marketing_site&quot; {"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  project_uuid           = &quot;11111111-2222-3333-4444-555555555555&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  name                   = &quot;Marketing site&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  client_type            = &quot;confidential&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  redirect_uris          = [&quot;https://example.com/auth/callback&quot;]"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  grants                 = [&quot;authorization_code&quot;, &quot;refresh_token&quot;]"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  scopes                 = [&quot;openid&quot;, &quot;profile&quot;, &quot;email&quot;, &quot;offline_access&quot;]"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  access_token_type      = &quot;jwt&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  access_token_lifetime  = 3600"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  refresh_token_lifetime = 2592000"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  oidc_enabled           = true"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="}"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="output &quot;client_id&quot; {"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  value = blackwall_oauth_client.marketing_site.id"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="}"/>
                <para ALIGN="0" LINESP="9"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="output &quot;client_secret&quot; {"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  value     = blackwall_oauth_client.marketing_site.client_secret"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="  sensitive = true"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="}"/>
                <trail ALIGN="0" LINESP="9"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="152" YPOS="25283.2" OwnPage="55" ItemID="1899042470" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="152" gYpos="25283.2" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
