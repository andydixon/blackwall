                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The sandbox is read-only and does not issue real tokens. It bypasses WebAuthn so you can quickly verify precedence without going through the full login flow."/>
