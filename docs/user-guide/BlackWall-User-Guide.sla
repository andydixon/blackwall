        <PAGEOBJECT XPOS="762" YPOS="25687" OwnPage="58" ItemID="1906421750" PTYPE="4" WIDTH="476.28" HEIGHT="240.4" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 240.4 L0 240.4 L0 0 Z" copath="M0 0 L476.28 0 L476.28 240.4 L0 240.4 L0 0 Z" gXpos="762" gYpos="25687" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="10.2" FONT="Noto Sans Mono Regular" FONTSIZE="7.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="Symptom  |  Cause"/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="error=invalid_request&amp;error_description=Invalid+redirect_uri  |  The redirect URI you sent does not exactly match a registered one. Trailing slashes count."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="error=invalid_request&amp;error_description=code_challenge+is+required  |  You forgot PKCE. Mandatory in Blackwall."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="error=access_denied&amp;error_description=User+not+authorized+for+this+project  |  The signed-in user is not assigned to the client's project."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="error=invalid_request mentioning max_age  |  max_age was negative, fractional, non-numeric, or too large. Send non-negative whole seconds."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="error=unauthorized_client on an openid request  |  OIDC is disabled for that client in Admin."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="error=invalid_grant at the token endpoint  |  The code is expired, already used, or the code_verifier does not match."/>
                <para ALIGN="0" LINESP="10.2"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="7.2" FCOLOR="GuideInk" CH="error=invalid_client at the token endpoint  |  The client secret is wrong, or you used Authorization: Basic for a public client."/>
                <trail ALIGN="0" LINESP="10.2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="152" YPOS="27283.89" OwnPage="59" ItemID="1903815926" PTYPE="5" WIDTH="476.28" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" PWIDTH="0.5" SHADE="nan" PCOLOR2="GuideRule" PLINEART="1" path="" gXpos="152" gYpos="27283.89" gWidth="0" gHeight="0" LAYER="0"/>
