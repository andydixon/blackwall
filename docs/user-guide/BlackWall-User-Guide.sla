                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Only a super_admin has manage_licences, so only that role can issue or revoke. A scoped operator has view_licences and can inspect and download the licence for projects they can reach. Issuance, failed issuance, and revocation are audited without copying the entity name or token into the audit log."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
