        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="48819.6" OwnPage="110" ItemID="1968193734" PTYPE="4" WIDTH="476.28" HEIGHT="85" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="GuideCode" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="9" TEXTRA="9" BEXTRA="9" REXTRA="9" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 85 L0 85 L0 0 Z" copath="M0 0 L476.28 0 L476.28 85 L0 85 L0 0 Z" gXpos="762" gYpos="48819.6" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="9" FONT="Noto Sans Mono Regular" FONTSIZE="6.8"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="type Signer interface {"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    KeyID() string"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    Algorithm() string                  // &quot;RS256&quot;"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    PublicKey() *rsa.PublicKey          // for JWKS export"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    Sign(data []byte) ([]byte, error)"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="    Verify(data, sig []byte) error"/>
                <para ALIGN="0" LINESP="9"/>
                <ITEXT FONT="Noto Sans Mono Regular" FONTSIZE="6.8" FCOLOR="GuideInk" CH="}"/>
                <trail ALIGN="0" LINESP="9"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="48914.6" OwnPage="110" ItemID="1968479622" PTYPE="4" WIDTH="476.28" HEIGHT="17.1" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" copath="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" gXpos="762" gYpos="48914.6" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="Today's implementations:"/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="48938.7" OwnPage="110" ItemID="1968462726" PTYPE="4" WIDTH="476.28" HEIGHT="43" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 43 L0 43 L0 0 Z" copath="M0 0 L476.28 0 L476.28 43 L0 43 L0 0 Z" gXpos="762" gYpos="48938.7" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13" FONT="Lato Regular" FONTSIZE="9.1"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• LocalDBSigner — the existing path. Private key materialised into the process at boot."/>
                <para ALIGN="0" LINESP="13"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.1" FCOLOR="GuideInk" CH="• kmsSignerStub — placeholder that fails loudly if the operator selects a cloud backend in config but the matching build tag was not enabled."/>
                <trail ALIGN="0" LINESP="13"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="48989.7" OwnPage="110" ItemID="1968646838" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="48989.7" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17" FONT="Lato Bold" FONTSIZE="13"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="Adding a real backend"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="49021.7" OwnPage="110" ItemID="1968741734" PTYPE="4" WIDTH="476.28" HEIGHT="43.3" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" copath="M0 0 L476.28 0 L476.28 43.3 L0 43.3 L0 0 Z" gXpos="762" gYpos="49021.7" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The pattern is intentionally similar across clouds. Each signer dispatches the SHA-256 digest of data and returns the cloud's signature bytes. Each implementation lives behind a Go build tag so the cloud SDK only inflates the binary for operators who actually need it."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="49072" OwnPage="110" ItemID="1968856598" PTYPE="4" WIDTH="476.28" HEIGHT="17.1" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" copath="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" gXpos="762" gYpos="49072" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
