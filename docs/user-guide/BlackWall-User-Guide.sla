        <PAGEOBJECT XPOS="747" YPOS="20363" OwnPage="46" ItemID="1879362518" PTYPE="4" WIDTH="476.28" HEIGHT="69.5" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 69.5 L0 69.5 L0 0 Z" copath="M0 0 L476.28 0 L476.28 69.5 L0 69.5 L0 0 Z" gXpos="747" gYpos="20363" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="If private material may have escaped, stop issuance, preserve the audit trail, mark that key compromised, install a newly generated key, restart, and reissue affected licences only after independently checking their entities and hostnames. Revoke the old licence rows with an incident reference and tell every product verifier to refresh immediately. Never return a compromised key to active."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="20439.5" OwnPage="46" ItemID="1879609238" PTYPE="4" WIDTH="476.28" HEIGHT="21" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" copath="M0 0 L476.28 0 L476.28 21 L0 21 L0 0 Z" gXpos="762" gYpos="20439.5" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="17" FONT="Lato Bold" FONTSIZE="13"/>
                <ITEXT FONT="Lato Bold" FONTSIZE="13" FCOLOR="GuideInk" CH="Renewal reminders"/>
                <trail ALIGN="0" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="20471.5" OwnPage="46" ItemID="1879591302" PTYPE="4" WIDTH="476.28" HEIGHT="69.5" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 69.5 L0 69.5 L0 0 Z" copath="M0 0 L476.28 0 L476.28 69.5 L0 69.5 L0 0 Z" gXpos="762" gYpos="20471.5" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="When enabled, Blackwall queues one renewal email at 30, 14, 7, 2, and 1 UTC calendar days before an active licence expires. The recipient is the active designated administrator of the project's organisation; their display label must be a valid email address. Revoked licences, disabled projects or organisations, inactive users, and former designated administrators are checked again immediately before delivery and are cancelled rather than emailed."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="20548" OwnPage="46" ItemID="1879946614" PTYPE="4" WIDTH="476.28" HEIGHT="69.5" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 69.5 L0 69.5 L0 0 Z" copath="M0 0 L476.28 0 L476.28 69.5 L0 69.5 L0 0 Z" gXpos="762" gYpos="20548" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The project licence page shows mail readiness, the resolved recipient, and recent reminder history. Delivery uses a durable, duplicate-safe MySQL queue, multi-instance row leases, bounded retries, and a stable opaque Message-ID. Messages contain useful renewal metadata but never the licence token, hostname or feature claims, instance allowance, or customer reference. See Project Licence Renewal Reminders (licensing/RENEWAL_REMINDERS.md) for secure SMTP configuration and the operating runbook."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="762" YPOS="20624.5" OwnPage="46" ItemID="1880165846" PTYPE="4" WIDTH="476.28" HEIGHT="17.1" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" copath="M0 0 L476.28 0 L476.28 17.1 L0 17.1 L0 0 Z" gXpos="762" gYpos="20624.5" gWidth="0" gHeight="0" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
