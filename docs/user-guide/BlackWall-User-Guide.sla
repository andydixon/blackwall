        <PAGEOBJECT XPOS="390.14" YPOS="19452" OwnPage="43" ItemID="1871662870" PTYPE="4" WIDTH="238.14" HEIGHT="12" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L238.14 0 L238.14 12 L0 12 L0 0 Z" copath="M0 0 L238.14 0 L238.14 12 L0 12 L0 0 Z" gXpos="390.14" gYpos="19452" gWidth="0" gHeight="0" ALIGN="2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
