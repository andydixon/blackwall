                <DefaultStyle ALIGN="0" LINESP="13.1" FONT="Lato Regular" FONTSIZE="9.3"/>
                <ITEXT FONT="Lato Regular" FONTSIZE="9.3" FCOLOR="GuideInk" CH="The /oauth/token endpoint accepts cross-origin requests from registered redirect URIs. No additional CORS configuration is required on Blackwall's side; your SPA's domain just needs to be listed as a redirect URI on the public client."/>
                <trail ALIGN="0" LINESP="13.1"/>
            </StoryText>
        </PAGEOBJECT>
